rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(householdId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    match /householdInvites/{code} {
      allow read: if signedIn() &&
        (resource.data.email == request.auth.token.email ||
          resource.data.createdBy == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        isMember(request.resource.data.householdId);
      allow delete: if signedIn() &&
        (resource.data.createdBy == request.auth.uid ||
          resource.data.email == request.auth.token.email);
    }

    match /households/{householdId} {
      allow read: if isMember(householdId);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isMember(householdId) &&
        resource.data.ownerUid == request.auth.uid;

      match /members/{userId} {
        allow read: if signedIn() &&
          (request.auth.uid == userId || isMember(householdId));
        allow create: if signedIn() &&
          request.auth.uid == userId &&
          (getAfter(/databases/$(database)/documents/households/$(householdId)).data.ownerUid == request.auth.uid ||
            existsAfter(/databases/$(database)/documents/households/$(householdId)/inviteClaims/$(request.auth.uid)));
        allow update, delete: if isMember(householdId) &&
          (request.auth.uid == userId ||
            resource.data.role == 'owner');
      }

      match /inviteClaims/{userId} {
        allow create: if signedIn() &&
          request.auth.uid == userId &&
          exists(/databases/$(database)/documents/householdInvites/$(request.resource.data.inviteCode)) &&
          get(/databases/$(database)/documents/householdInvites/$(request.resource.data.inviteCode)).data.email == request.auth.token.email &&
          get(/databases/$(database)/documents/householdInvites/$(request.resource.data.inviteCode)).data.householdId == householdId;
        allow read: if isMember(householdId);
        allow delete: if isMember(householdId);
      }

      match /tables/{tableName} {
        allow read, write: if isMember(householdId);
      }

      match /metadata/{documentId} {
        allow read, write: if isMember(householdId);
      }
    }
  }
}

